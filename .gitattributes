# ─────────────────────────────────────────────────────────────────────────────
#  .gitattributes — Normalize line endings across Windows/Linux/macOS
# ─────────────────────────────────────────────────────────────────────────────

# Auto-detect text files and normalize to LF in the repository
* text=auto eol=lf

# Explicitly LF for these file types (critical for Docker/shell scripts on Linux VPS)
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.env*      text eol=lf
*.gitignore text eol=lf
*.lock      text eol=lf

# Binary files — no line ending conversion
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    binary
*.webp   binary
*.avif   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.otf    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.tar    binary

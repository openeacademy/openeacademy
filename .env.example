# ─────────────────────────────────────────────────────────────────────────────
#  Root-level .env for Docker Compose
#  Copy to .env and fill in production values — NEVER commit .env
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (used by docker-compose.yml postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=opene_academy

# Redis password (used by docker-compose.yml redis service)
REDIS_PASSWORD=change_me_redis_password
